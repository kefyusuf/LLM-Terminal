# AI Model Kontrol Configuration
# Copy this file to .env and fill in your values

# HuggingFace API Token (optional, increases rate limits)
# Canonical project setting: AIMODEL_HF_TOKEN
# Standard Hugging Face HF_TOKEN is also accepted as a fallback.
# Get your token from: https://huggingface.co/settings/tokens
# Token type: Read-only
AIMODEL_HF_TOKEN=your_huggingface_token_here

# HuggingFace Search Settings
AIMODEL_HF_SEARCH_LIMIT=15          # Results per page
AIMODEL_HF_SEARCH_MAX_PAGES=10      # Maximum pages to fetch

# HuggingFace download directory (optional)
# Defaults to the OS-specific per-user app data directory under models/.
# AIMODEL_HF_MODELS_DIR=/custom/path/models

# Ollama Settings
AIMODEL_OLLAMA_API_BASE=http://localhost:11434
AIMODEL_OLLAMA_TIMEOUT=5

# Cache Settings
AIMODEL_SEARCH_CACHE_TTL_SECONDS=90
AIMODEL_SEARCH_CACHE_MAX_ENTRIES=20

# Persistent database paths (optional)
# By default cache.db and downloads.db live in the OS-specific per-user data directory.
# AIMODEL_CACHE_DB_PATH=/custom/path/cache.db
# AIMODEL_DOWNLOAD_DB_PATH=/custom/path/downloads.db
